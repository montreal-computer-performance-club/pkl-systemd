module declix.systemd.Mount;

extends "./Unit.pkl";

unit: UnitSection
install: InstallSection
mount: MountSection

// https://www.freedesktop.org/software/systemd/man/latest/systemd.mount.html
class MountSection {
    // Mandatory properties
    what: String
    where: String
    
    // Optional mount configuration
    type: String?
    options: String?
    
    // Mount behavior options
    sloppyOptions: Boolean?
    lazyUnmount: Boolean?
    readWriteOnly: Boolean?
    forceUnmount: Boolean?
    
    // Directory and timeout settings
    directoryMode: String?
    timeoutSec: Duration?
}
