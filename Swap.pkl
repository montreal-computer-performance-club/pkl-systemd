module declix.systemd.Swap;

extends "./Unit.pkl";

unit: UnitSection
install: InstallSection
swap: SwapSection

// https://www.freedesktop.org/software/systemd/man/latest/systemd.swap.html
class SwapSection {
    // Mandatory - swap device or file path
    what: String
    
    // Optional swap configuration
    priority: UInt?
    options: String?
    
    // Timeout configuration
    timeoutSec: Duration?
}