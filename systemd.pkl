/// Re-exports all systemd unit types for convenient access
module systemd

// Import all unit types
import "Automount.pkl" as AutomountModule
import "Device.pkl" as DeviceModule
import "Mount.pkl" as MountModule
import "Path.pkl" as PathModule
import "Scope.pkl" as ScopeModule
import "Service.pkl" as ServiceModule
import "Slice.pkl" as SliceModule
import "Socket.pkl" as SocketModule
import "Swap.pkl" as SwapModule
import "Target.pkl" as TargetModule
import "Timer.pkl" as TimerModule
import "Unit.pkl" as UnitModule

// Re-export all types
typealias Service = ServiceModule
typealias Timer = TimerModule
typealias Socket = SocketModule
typealias Mount = MountModule
typealias Target = TargetModule
typealias Path = PathModule
typealias Swap = SwapModule
typealias Automount = AutomountModule
typealias Slice = SliceModule
typealias Scope = ScopeModule
typealias Device = DeviceModule
typealias Unit = UnitModule
