module declix.systemd.Scope;

extends "./Unit.pkl";

unit: UnitSection
install: InstallSection
scope: ScopeSection

// https://www.freedesktop.org/software/systemd/man/latest/systemd.scope.html
class ScopeSection {
    // Scope-specific configuration
    oOMPolicy: OOMPolicy?
    runtimeMaxSec: Duration?
    runtimeRandomizedExtraSec: Duration?
    
    // Resource control settings (from systemd.resource-control)
    // CPU accounting and limits
    cPUAccounting: Boolean?
    cPUWeight: UInt?
    startupCPUWeight: UInt?
    cPUQuota: String?
    
    // Memory accounting and limits
    memoryAccounting: Boolean?
    memoryMin: String?
    memoryLow: String?
    memoryHigh: String?
    memoryMax: String?
    memorySwapMax: String?
    
    // Tasks accounting and limits
    tasksAccounting: Boolean?
    tasksMax: String?
    
    // IO accounting and limits
    iOAccounting: Boolean?
    iOWeight: UInt?
    startupIOWeight: UInt?
    
    // Kill settings (from systemd.kill)
    killMode: KillMode?
    killSignal: String?
    finalKillSignal: String?
    sendSIGHUP: Boolean?
    sendSIGKILL: Boolean?
    watchdogSignal: String?
}

// Type aliases
local typealias OOMPolicy = "continue" | "stop" | "kill"
local typealias KillMode = "control-group" | "mixed" | "process" | "none"