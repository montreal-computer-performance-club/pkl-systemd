examples {
  ["automount.pkl"] {
    """
    [Unit]
    Description=Automount for user home directories
    Documentation=man:systemd.automount(5)
    Documentation=man:autofs(8)
    Requires=network.target
    Requires=nfs-client.target
    Conflicts=umount.target
    Before=umount.target
    After=network.target
    After=nfs-client.target
    
    [Install]
    WantedBy=remote-fs.target
    
    [Automount]
    Where=/home/users
    ExtraOptions=timeout=60,retry=1
    DirectoryMode=0755
    TimeoutIdleSec=300s
    
    """
  }
  ["backup-timer.pkl"] {
    """
    [Unit]
    Description=Daily backup timer with flexible scheduling
    Documentation=man:backup-service(8)
    Requires=network.target
    Requires=local-fs.target
    Conflicts=shutdown.target
    Before=shutdown.target
    After=network-online.target
    After=backup.service
    RequiresMountsFor=/backup/storage
    
    [Install]
    WantedBy=timers.target
    Also=backup.service
    
    [Timer]
    OnBootSec=900s
    OnUnitActiveSec=86400s
    OnCalendar=daily
    AccuracySec=60s
    RandomizedDelaySec=1800s
    FixedRandomDelay=no
    OnClockChange=yes
    OnTimezoneChange=yes
    Unit=backup.service
    Persistent=yes
    WakeSystem=no
    RemainAfterElapse=no
    DeferReactivation=yes
    
    """
  }
  ["hello.pkl"] {
    """
    [Unit]
    Description=Hello World Service
    Wants=network-online.target
    After=network-online.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Service]
    Type=simple
    ExecStart=/usr/bin/echo 'Hello World'
    Restart=on-failure
    RestartSec=5s
    
    """
  }
  ["mount.pkl"] {
    #"""
    [Unit]
    Description=Example filesystem mount
    Requires=systemd-fsck@dev-disk-by\x2duuid\x2d12345.service
    Conflicts=umount.target
    Before=umount.target
    After=systemd-fsck@dev-disk-by\x2duuid\x2d12345.service
    
    [Install]
    WantedBy=multi-user.target
    
    [Mount]
    What=/dev/disk/by-uuid/12345678-1234-1234-1234-123456789abc
    Where=/mnt/data
    Type=ext4
    Options=defaults,noatime,user_xattr
    ForceUnmount=yes
    DirectoryMode=0755
    TimeoutSec=30s
    
    """#
  }
  ["network-mount.pkl"] {
    """
    [Unit]
    Description=NFS mount for shared application data
    Documentation=man:mount.nfs(8)
    Documentation=man:systemd.mount(5)
    Requires=network-online.target
    Requires=rpcbind.service
    Requires=nfs-client.target
    Conflicts=umount.target
    Conflicts=shutdown.target
    Before=remote-fs.target
    Before=umount.target
    Before=shutdown.target
    After=network-online.target
    After=rpcbind.service
    After=nfs-client.target
    After=remote-fs-pre.target
    OnFailure=mount-failure-notify@%n.service
    WantsMountsFor=/mnt
    StartLimitAction=none
    StartLimitBurst=3
    StartLimitIntervalSec=60s
    
    [Install]
    RequiredBy=application-server.service
    RequiredBy=backup.service
    WantedBy=remote-fs.target
    Also=nfs-client.target
    Also=shared-data-monitor.service
    
    [Mount]
    What=nfs-server.example.com:/export/shared-data
    Where=/mnt/shared-data
    Type=nfs4
    Options=defaults,rsize=32768,wsize=32768,hard,intr,timeo=30,retrans=3,proto=tcp,sec=krb5p,fsc,noatime,user_xattr,_netdev
    SloppyOptions=yes
    LazyUnmount=yes
    ReadWriteOnly=no
    ForceUnmount=no
    DirectoryMode=0755
    TimeoutSec=60s
    
    """
  }
  ["path.pkl"] {
    """
    [Unit]
    Description=Watch for configuration file changes
    Documentation=man:app-config-watcher(8)
    Requires=app-reload.service
    After=app-reload.service
    
    [Install]
    WantedBy=multi-user.target
    
    [Path]
    PathExistsGlob=/etc/myapp/*.conf
    PathChanged=/etc/myapp
    Unit=app-reload.service
    MakeDirectory=yes
    DirectoryMode=0755
    TriggerLimitIntervalSec=5s
    TriggerLimitBurst=3
    
    """
  }
  ["podman-service.pkl"] {
    """
    [Unit]
    Description=testService
    Wants=network-online.target
    After=network-online.target
    RequiresMountsFor=/run/containers/storage
    
    [Install]
    WantedBy=default.target
    
    [Service]
    Type=forking
    PidFile=%t/%n.pid
    ExecStartPre=/usr/bin/rm -f %t/%n.pid %t/%n.cid
    ExecReload=podman restart testService
    ExecStop=/usr/bin/sh -c "podman rm -f `cat %t/%n.cid`"
    Restart=always
    TimeoutStopSec=70s
    KillMode=control-group
    Environment=PODMAN_SYSTEMD_UNIT=%n
    
    """
  }
  ["reference-service.pkl"] {
    """
    [Unit]
    Description=Advanced microservice with comprehensive configuration
    Documentation=man:advanced-service(8)
    Documentation=https://example.com/docs/advanced-service
    Documentation=file:///usr/share/doc/advanced-service/README.md
    Wants=network-online.target
    Wants=time-sync.target
    Wants=systemd-resolved.service
    Requires=basic.target
    Conflicts=shutdown.target
    Before=multi-user.target
    After=network-online.target
    After=systemd-resolved.service
    OnFailure=notify-failure@%n.service
    RequiresMountsFor=/var/lib/advanced-service
    RequiresMountsFor=/run/advanced-service
    StartLimitAction=reboot
    StartLimitBurst=5
    StartLimitIntervalSec=300s
    AllowIsolate=no
    DefaultDependencies=yes
    
    [Install]
    Alias=microservice.service
    RequiredBy=application.target
    WantedBy=multi-user.target
    Also=advanced-service-monitor.timer
    Also=advanced-service-backup.service
    
    [Service]
    Type=notify
    ExitType=main
    RemainAfterExit=no
    GuessMainPID=no
    PidFile=/run/advanced-service/service.pid
    BusName=com.example.AdvancedService
    ExecStart=/usr/bin/advanced-service --daemon --config=/etc/advanced-service/config.yaml
    ExecStartPre=/usr/bin/mkdir -p /run/advanced-service
    ExecStartPre=/usr/bin/chown advanced-service:advanced-service /run/advanced-service
    ExecStartPre=/usr/bin/advanced-service --validate-config
    ExecStartPost=/usr/bin/advanced-service --post-start-hook
    ExecReload=/bin/kill -HUP $MAINPID
    ExecStop=/usr/bin/advanced-service --graceful-shutdown
    ExecStopPost=/usr/bin/rm -rf /run/advanced-service
    Restart=on-failure
    RestartSec=10s
    RestartSteps=3
    RestartMaxDelaySec=60s
    RestartMode=normal
    RestartForceExitStatus=SIGKILL
    RestartForceExitStatus=SIGABRT
    RestartPreventExitStatus=SIGUSR1
    TimeoutStartSec=60s
    TimeoutStopSec=30s
    TimeoutAbortSec=10s
    TimeoutStartFailureMode=terminate
    TimeoutStopFailureMode=kill
    RuntimeMaxSec=86400s
    RuntimeRandomizedExtraSec=3600s
    WatchdogSec=30s
    WatchdogSignal=SIGTERM
    KillMode=mixed
    KillSignal=SIGTERM
    FinalKillSignal=SIGKILL
    SendSIGHUP=yes
    SendSIGKILL=yes
    Environment=SERVICE_ENV=production
    Environment=LOG_LEVEL=info
    Environment=CONFIG_FILE=/etc/advanced-service/config.yaml
    Environment=DATA_DIR=/var/lib/advanced-service
    EnvironmentFile=/etc/advanced-service/environment
    EnvironmentFile=/etc/advanced-service/secrets.env
    SuccessExitStatus=0
    SuccessExitStatus=SIGUSR1
    NonBlocking=no
    NotifyAccess=main
    FileDescriptorStoreMax=10
    FileDescriptorStorePreserve=restart
    RootDirectoryStartOnly=no
    OomPolicy=stop
    
    """
  }
  ["scope.pkl"] {
    """
    [Unit]
    Description=User session scope for external processes
    Documentation=man:systemd.scope(5)
    
    [Install]
    
    [Scope]
    OOMPolicy=kill
    RuntimeMaxSec=86400s
    RuntimeRandomizedExtraSec=3600s
    CPUAccounting=yes
    CPUWeight=100
    CPUQuota=25%
    MemoryAccounting=yes
    MemoryHigh=1G
    MemoryMax=2G
    TasksAccounting=yes
    TasksMax=500
    IOAccounting=yes
    IOWeight=100
    KillMode=control-group
    KillSignal=SIGTERM
    FinalKillSignal=SIGKILL
    SendSIGHUP=no
    SendSIGKILL=yes
    
    """
  }
  ["slice.pkl"] {
    """
    [Unit]
    Description=Application slice for web services
    Documentation=https://example.com/docs/resource-management
    Requires=-.slice
    After=-.slice
    
    [Install]
    WantedBy=slices.target
    
    [Slice]
    CPUAccounting=yes
    CPUWeight=200
    CPUQuota=50%
    MemoryAccounting=yes
    MemoryHigh=2G
    MemoryMax=4G
    MemorySwapMax=1G
    ManagedOOMSwap=kill
    ManagedOOMMemoryPressure=kill
    ManagedOOMMemoryPressureLimit=80%
    TasksAccounting=yes
    TasksMax=1000
    IOAccounting=yes
    IOWeight=100
    DeviceAllow=/dev/null rw
    DeviceAllow=/dev/zero rw
    DeviceAllow=/dev/random r
    DeviceAllow=/dev/urandom r
    DevicePolicy=strict
    
    """
  }
  ["socket.pkl"] {
    """
    [Unit]
    Description=Example socket for service communication
    Requires=network.target
    After=network.target
    
    [Install]
    WantedBy=sockets.target
    
    [Socket]
    ListenStream=/var/run/example.socket
    SocketUser=www-data
    SocketGroup=www-data
    SocketMode=0660
    Accept=yes
    MaxConnections=100
    RemoveOnStop=yes
    
    """
  }
  ["swap.pkl"] {
    """
    [Unit]
    Description=Swap file /swapfile
    Documentation=man:swapon(8)
    Documentation=man:systemd.swap(5)
    Requires=local-fs.target
    Conflicts=umount.target
    Before=umount.target
    After=local-fs.target
    
    [Install]
    WantedBy=swap.target
    
    [Swap]
    What=/swapfile
    Priority=10
    Options=defaults
    TimeoutSec=30s
    
    """
  }
  ["target.pkl"] {
    """
    [Unit]
    Description=Web Stack Target
    Documentation=https://example.com/docs/web-stack
    Wants=nginx.service
    Wants=postgresql.service
    Wants=redis.service
    Requires=network.target
    Requires=multi-user.target
    Conflicts=shutdown.target
    Before=shutdown.target
    After=network.target
    After=multi-user.target
    AllowIsolate=yes
    
    [Install]
    WantedBy=multi-user.target
    Also=nginx.service
    Also=postgresql.service
    Also=redis.service
    
    """
  }
  ["timer.pkl"] {
    """
    [Unit]
    Description=Cleanup podman resources timer
    After=podman.service
    
    [Install]
    WantedBy=multi-user.target
    
    [Timer]
    OnUnitInactiveSec=3600s
    RandomizedDelaySec=600s
    Persistent=yes
    
    """
  }
  ["web-socket.pkl"] {
    """
    [Unit]
    Description=Web service socket with multiple listeners
    Documentation=man:web-service(8)
    Documentation=https://example.com/docs/web-service-socket
    Requires=network.target
    Conflicts=shutdown.target
    Before=shutdown.target
    After=network.target
    After=systemd-resolved.service
    DefaultDependencies=no
    
    [Install]
    RequiredBy=web-stack.target
    WantedBy=sockets.target
    Also=web-service.service
    
    [Socket]
    ListenStream=127.0.0.1:8080
    ListenStream=[::1]:8080
    ListenStream=/run/web-service.sock
    SocketProtocol=tcp
    BindIPv6Only=ipv6-only
    Backlog=128
    SocketUser=www-data
    SocketGroup=www-data
    SocketMode=0660
    DirectoryMode=0755
    Accept=yes
    MaxConnections=1000
    MaxConnectionsPerSource=10
    KeepAlive=yes
    KeepAliveTimeSec=7200s
    KeepAliveIntervalSec=75s
    KeepAliveProbes=9
    NoDelay=yes
    Priority=6
    ReceiveBuffer=65536
    SendBuffer=65536
    IPTOS=16
    Mark=1
    ReusePort=yes
    FreeBind=no
    Transparent=no
    Broadcast=no
    PassCredentials=yes
    PassSecurity=no
    PassPacketInfo=no
    Timestamping=off
    TCPCongestion=cubic
    ExecStartPre=/usr/bin/mkdir -p /run/web-service
    ExecStartPost=/usr/bin/chown www-data:www-data /run/web-service.sock
    ExecStopPost=/usr/bin/rm -f /run/web-service.sock
    Service=web-service.service
    RemoveOnStop=yes
    FileDescriptorName=web-socket
    PassFileDescriptorsToExec=yes
    TriggerLimitIntervalSec=2s
    TriggerLimitBurst=20
    PollLimitIntervalSec=1s
    PollLimitBurst=10
    
    """
  }
  ["podman/app-network.pkl"] {
    """
    [Unit]
    Description=Application Network
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Network]
    Driver=bridge
    Gateway=10.88.0.1
    Label=app=myapp
    Label=environment=production
    NetworkName=app-net
    Subnet=10.88.0.0/16
    
    """
  }
  ["podman/database-pod.pkl"] {
    """
    [Unit]
    Description=Database Pod with Security
    Requires=network.target
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Pod]
    DNS=10.0.0.1
    DNSSearch=internal.example.com
    DNSSearch=db.example.com
    ExitPolicy=continue
    GIDMap=0:100000:65536
    HostName=db-cluster.internal
    Label=app=database
    Label=tier=data
    Label=security=high
    Label=backup=enabled
    Network=db-network.network
    NetworkAlias=postgres.db
    NetworkAlias=redis.db
    NetworkAlias=primary.db
    PodName=database-cluster
    PodmanArgs=--security-opt=label:disable=false
    PodmanArgs=--security-opt=label:type=container_t
    PodmanArgs=--annotation=backup.schedule=0 2 * * *
    PodmanArgs=--annotation=monitoring.enabled=true
    PodmanArgs=--share=net
    PodmanArgs=--share=uts
    PodmanArgs=--infra-image=registry.redhat.io/ubi8/pause:latest
    PublishPort=5432:5432
    PublishPort=6379:6379
    UIDMap=0:100000:65536
    UserNS=keep-id
    Volume=postgres-data:/var/lib/postgresql/data:Z
    Volume=redis-data:/data:Z
    Volume=/etc/database/config:/etc/config:ro
    
    """
  }
  ["podman/isolated-network.pkl"] {
    """
    [Unit]
    Description=Isolated Internal Network
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Network]
    DNS=172.20.0.1
    DNS=8.8.8.8
    Driver=bridge
    Gateway=172.20.0.1
    IPv6=yes
    Internal=yes
    Label=tier=isolated
    Label=security=high
    NetworkName=isolated-net
    Options=com.docker.network.bridge.name=isolated0
    Options=com.docker.network.driver.mtu=1450
    Subnet=172.20.0.0/24
    
    """
  }
  ["podman/microservices-kube.pkl"] {
    """
    [Unit]
    Description=Microservices Stack
    Requires=webapp-network.service
    After=network.target
    After=webapp-network.service
    
    [Install]
    WantedBy=multi-user.target
    
    [Kube]
    Yaml=/app/k8s/microservices.yaml
    AutoUpdate=local
    ConfigMap=/app/k8s/config/app-config.yaml
    ConfigMap=/app/k8s/config/database-config.yaml
    ConfigMap=/app/k8s/secrets/api-keys.yaml
    ExitCodePropagation=all
    LogDriver=journald
    Network=microservices.network
    PodmanArgs=--uidmap=0:100000:65536
    PodmanArgs=--gidmap=0:100000:65536
    PodmanArgs=--volume=postgres-data:/var/lib/postgresql/data:Z
    PodmanArgs=--volume=redis-data:/data:Z
    PodmanArgs=--volume=/app/logs:/var/log/app:Z
    PodmanArgs=--volume=/app/uploads:/uploads:Z
    PublishPort=3000:3000
    PublishPort=3001:3001
    PublishPort=3002:3002
    PublishPort=9090:9090
    SetWorkingDirectory=unit
    UserNS=auto
    
    """
  }
  ["podman/multistage-build.pkl"] {
    """
    [Unit]
    Description=Multi-stage Application Build
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Build]
    ImageTag=localhost/myapp:production
    Annotation=org.opencontainers.image.source=https://github.com/example/myapp
    Annotation=org.opencontainers.image.documentation=https://docs.example.com/myapp
    Arch=amd64
    BuildArg=GO_VERSION=1.21
    BuildArg=CGO_ENABLED=0
    BuildArg=GOOS=linux
    File=./docker/Containerfile.prod
    Label=app=myapp
    Label=tier=backend
    Label=build-type=production
    PodmanArgs=--squash
    PodmanArgs=--rm
    Pull=always
    Secret=id=github_token,src=/run/secrets/github_token
    Secret=id=registry_auth,src=/run/secrets/registry_auth
    SetWorkingDirectory=/workspace
    TLSVerify=yes
    Target=production
    Volume=/var/cache/go:/go/pkg/mod:Z
    Volume=/var/cache/build:/root/.cache:Z
    
    """
  }
  ["podman/nginx.pkl"] {
    """
    [Unit]
    Description=Nginx Web Server Container
    After=network-online.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Container]
    ContainerName=nginx
    Environment=NGINX_HOST=example.com
    Environment=NGINX_PORT=80
    HealthCmd=curl -f http://localhost/ || exit 1
    HealthInterval=30s
    HealthRetries=3
    HealthTimeout=3s
    Image=docker.io/library/nginx:latest
    PublishPort=80:80
    PublishPort=443:443
    Pull=missing
    Volume=/etc/nginx/conf.d:/etc/nginx/conf.d:ro
    Volume=/var/www/html:/usr/share/nginx/html:ro
    
    [Service]
    Restart=always
    RestartSec=5s
    
    """
  }
  ["podman/postgres-volume.pkl"] {
    """
    [Unit]
    Description=PostgreSQL Data Volume
    After=local-fs.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Volume]
    Driver=local
    Label=app=postgres
    Label=purpose=database-storage
    VolumeName=postgres-data
    
    """
  }
  ["podman/postgres.pkl"] {
    """
    [Unit]
    Description=PostgreSQL Database Container
    Requires=network-online.target
    After=network-online.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Container]
    ContainerName=postgres
    Environment=POSTGRES_DB=myapp
    Environment=POSTGRES_USER=myuser
    Environment=POSTGRES_PASSWORD=mypassword
    Environment=PGDATA=/var/lib/postgresql/data/pgdata
    HealthCmd=pg_isready -U myuser -d myapp
    HealthInterval=10s
    HealthOnFailure=kill
    HealthRetries=5
    HealthStartPeriod=30s
    HealthTimeout=5s
    Image=docker.io/library/postgres:15
    Memory=1G
    PodmanArgs=--cpus=2.0
    PublishPort=5432:5432
    Pull=missing
    Volume=postgres-data.volume:/var/lib/postgresql/data
    Volume=/etc/postgresql/postgresql.conf:/etc/postgresql/postgresql.conf:ro
    
    [Service]
    Restart=on-failure
    RestartSec=10s
    TimeoutStartSec=90s
    
    """
  }
  ["podman/private-registry-image.pkl"] {
    """
    [Unit]
    Description=Private application image
    Wants=network-online.target
    After=network-online.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Image]
    Image=private.company.com/apps/webapp:v2.1.0
    Arch=amd64
    AuthFile=/etc/containers/registries/auth.json
    CertDir=/etc/containers/registries/certs.d
    GlobalArgs=--log-level=info
    OS=linux
    Retry=3
    RetryDelay=10s
    TLSVerify=yes
    
    """
  }
  ["podman/redis-image.pkl"] {
    """
    [Unit]
    Description=Redis container image
    After=network-online.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Image]
    Image=docker.io/library/redis:7-alpine
    TLSVerify=yes
    
    """
  }
  ["podman/redis.pkl"] {
    """
    [Unit]
    Description=Redis In-Memory Data Store
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Container]
    ContainerName=redis
    Exec=redis-server /usr/local/etc/redis/redis.conf
    Group=999
    HealthCmd=redis-cli ping
    HealthInterval=10s
    HealthRetries=3
    HealthTimeout=3s
    Image=docker.io/library/redis:7-alpine
    Memory=512M
    NoNewPrivileges=yes
    PodmanArgs=--cpus=1.0
    PublishPort=6379:6379
    Pull=newer
    ReadOnly=yes
    User=999
    Volume=redis-data:/data
    Volume=/etc/redis/redis.conf:/usr/local/etc/redis/redis.conf:ro
    
    [Service]
    Restart=on-failure
    RestartSec=5s
    
    """
  }
  ["podman/shared-volume.pkl"] {
    """
    [Unit]
    Description=Shared Application Volume
    After=local-fs.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Volume]
    Device=tmpfs
    Driver=local
    Group=1000
    Label=app=shared
    Label=tier=storage
    Options=size=1G
    Type=tmpfs
    User=1000
    VolumeName=app-shared
    
    """
  }
  ["podman/web-pod.pkl"] {
    """
    [Unit]
    Description=Web Application Pod
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Pod]
    DNS=8.8.8.8
    DNS=8.8.4.4
    ExitPolicy=stop
    HostName=webapp.local
    Label=app=webapp
    Label=tier=web
    Label=environment=production
    Network=bridge
    PodName=webapp
    PodmanArgs=--share=net
    PodmanArgs=--share=ipc
    PublishPort=8080:80
    PublishPort=8443:443
    Volume=/var/log/webapp:/var/log:Z
    Volume=/etc/ssl/certs:/etc/ssl/certs:ro
    
    """
  }
  ["podman/webapp-build.pkl"] {
    """
    [Unit]
    Description=Web Application Build
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Build]
    ImageTag=localhost/webapp:latest
    BuildArg=NODE_VERSION=18
    BuildArg=BUILD_ENV=production
    Environment=BUILDKIT_PROGRESS=plain
    File=/app/Containerfile
    ForceRM=yes
    Label=app=webapp
    Label=version=1.0.0
    Label=maintainer=devops@example.com
    Network=host
    PodmanArgs=--rm
    Pull=missing
    SetWorkingDirectory=/app
    
    """
  }
  ["podman/webapp-kube.pkl"] {
    """
    [Unit]
    Description=Web Application Kubernetes Deployment
    After=network.target
    
    [Install]
    WantedBy=multi-user.target
    
    [Kube]
    Yaml=/etc/kubernetes/webapp/deployment.yaml
    AutoUpdate=registry
    ConfigMap=/etc/kubernetes/webapp/configmap.yaml
    ConfigMap=/etc/kubernetes/webapp/secrets.yaml
    ExitCodePropagation=any
    LogDriver=journald
    Network=webapp-net.network
    PodmanArgs=--volume=/var/log/webapp:/var/log:Z
    PodmanArgs=--volume=/etc/ssl/certs:/etc/ssl/certs:ro
    PublishPort=8080:80
    PublishPort=8443:443
    SetWorkingDirectory=yaml
    
    """
  }
}
