abstract module declix.systemd.Unit;

// https://www.freedesktop.org/software/systemd/man/latest/systemd.unit.html
class UnitSection {
    // Description and documentation
    description: String?
    documentation: (String|Listing<String>)?
    
    // Dependencies
    wants: (String|Listing<String>)?
    requires: (String|Listing<String>)?
    requisite: (String|Listing<String>)?
    bindsTo: (String|Listing<String>)?
    partOf: (String|Listing<String>)?
    upholds: (String|Listing<String>)?
    conflicts: (String|Listing<String>)?
    
    // Ordering
    before: (String|Listing<String>)?
    after: (String|Listing<String>)?
    
    // Failure and success handling
    onFailure: (String|Listing<String>)?
    onSuccess: (String|Listing<String>)?
    onFailureJobMode: JobMode?
    onSuccessJobMode: JobMode?
    
    // Reload and stop propagation
    propagatesReloadTo: (String|Listing<String>)?
    reloadPropagatedFrom: (String|Listing<String>)?
    propagatesStopTo: (String|Listing<String>)?
    stopPropagatedFrom: (String|Listing<String>)?
    
    // Namespace joining
    joinsNamespaceOf: (String|Listing<String>)?
    
    // Mount dependencies
    requiresMountsFor: (String|Listing<String>)?
    wantsMountsFor: (String|Listing<String>)?
    
    // Job configuration
    jobTimeoutSec: Duration?
    jobRunningTimeoutSec: Duration?
    jobTimeoutAction: JobTimeoutAction?
    jobTimeoutRebootArgument: String?
    
    // Failure and success actions
    failureAction: UnitAction?
    failureActionExitStatus: String?
    successAction: UnitAction?
    successActionExitStatus: String?
    
    // Start limit configuration
    startLimitAction: UnitAction?
    startLimitBurst: UInt?
    startLimitIntervalSec: Duration?
    
    // Reboot configuration
    rebootArgument: String?
    
    // Isolation and dependencies
    allowIsolate: Boolean?
    ignoreOnIsolate: Boolean?
    defaultDependencies: Boolean?
    
    // Stop configuration
    stopWhenUnneeded: Boolean?
    refuseManualStart: Boolean?
    refuseManualStop: Boolean?
    
    // Advanced options
    collectMode: CollectMode?
    sourcePath: String?
    surviveFinalKillSignal: Boolean?
}

// Job modes for failure/success handling
local typealias JobMode = "fail" | "replace" | "replace-irreversibly" | "isolate" | "flush" | "ignore-dependencies" | "ignore-requirements"

// Job timeout actions
local typealias JobTimeoutAction = "none" | "reboot" | "reboot-force" | "reboot-immediate" | "poweroff" | "poweroff-force" | "poweroff-immediate" | "exit" | "exit-force" | "halt" | "halt-force" | "halt-immediate" | "kexec" | "kexec-force" | "suspend" | "hibernate" | "hybrid-sleep" | "suspend-then-hibernate" | "lock"

// Unit actions for failure/success
local typealias UnitAction = "none" | "reboot" | "reboot-force" | "reboot-immediate" | "poweroff" | "poweroff-force" | "poweroff-immediate" | "exit" | "exit-force" | "halt" | "halt-force" | "halt-immediate" | "kexec" | "kexec-force" | "suspend" | "hibernate" | "hybrid-sleep" | "suspend-then-hibernate"


// Collect mode for cleanup
local typealias CollectMode = "inactive" | "inactive-or-failed"

// https://www.freedesktop.org/software/systemd/man/latest/systemd.unit.html
class InstallSection {
    alias: (String|Listing<String>)?
    also: (String|Listing<String>)?
    defaultInstance: String?
    requiredBy: (String|Listing<String>)?
    upheldBy: (String|Listing<String>)?
    wantedBy: (String|Listing<String>)?
}

local class UnitFileRenderer extends ValueRenderer {
    function renderDocument(value: Any): String = renderSections(value.toMap())

    function renderSections(map: Map): String = new Listing {
        for (name in map.keys) {
            when (map[name] != null) {
                renderSection(name, map[name])
            }
        }
    }.join("\n")

    function renderSection(name: String, section: Any): String = 
        let (content = renderSectionProperties(section))
        "[\(name.capitalize())]\n" + content + if (content == "") "" else "\n"
    
    function renderSectionProperties(section: Any): String = 
        section.toMap().entries
            .filter((entry) -> entry.value != null)
            .map((entry) -> renderProperty(entry.key, entry.value))
            .filter((rendered) -> rendered != "")
            .join("\n")

    function renderProperty(name: String, value: Any): String = 
        if (value is Mapping) new Listing {
            for (key in value.toMap().keys) {
                "\(name.capitalize())=\(key)=" + renderValue(value.toMap()[key])
            }
        }.join("\n")
        else if (value is Listing && !value.isEmpty) new Listing {
            for (item in value) {
                "\(name.capitalize())=" + renderValue(item)
            }
        }.join("\n")
        else if (value is Listing && value.isEmpty) ""
        else if (value is String || value is Number || value is Boolean || value is Duration) "\(name.capitalize())=" + renderValue(value)
        else throw("unexpected value type \(value.getClass()) for property \(name)")

    function renderValue(value: Any): String =
        if (value is String) value
        else if (value is Number) "\(value)"
        else if (value is Boolean) if (value) "yes" else "no"
        else if (value is Duration) "\(value.toUnit("s").value)s"
        else throw("unexpected value \(value.getClass())")
}

output {
    renderer = new UnitFileRenderer { }
}