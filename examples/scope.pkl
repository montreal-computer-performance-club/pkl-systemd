amends "../Scope.pkl"

// Scope units cannot be defined with unit files: this renders a drop-in for
// scopes created by something else. Installed as
// /etc/systemd/system/session-.scope.d/50-limits.conf, it applies to every
// login session scope (session-1.scope, session-2.scope, ...).
scope = new {
  // Memory limits
  memoryHigh = "4G"
  memoryMax = "6G"

  // Task limits
  tasksMax = "2000"

  // Kill the whole session if one of its processes is killed by the OOM killer
  oOMPolicy = "kill"
}
