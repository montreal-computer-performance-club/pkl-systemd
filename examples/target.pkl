amends "../Target.pkl"

// Example target unit for grouping related services
unit = new {
  description = "Web Stack Target"
  documentation { "https://example.com/docs/web-stack" }

  // Dependencies on required services
  wants {
    "nginx.service"
    "postgresql.service"
    "redis.service"
  }
  requires {
    "network.target"
    "multi-user.target"
  }
  after {
    "network.target"
    "multi-user.target"
  }

  // Conflicts with shutdown
  conflicts { "shutdown.target" }
  before { "shutdown.target" }

  // Allow manual isolation
  allowIsolate = true
}

install = new {
  wantedBy { "multi-user.target" }

  // Also enable dependent services
  also {
    "nginx.service"
    "postgresql.service"
    "redis.service"
  }
}
