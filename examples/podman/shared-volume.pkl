amends "../../podman/Volume.pkl"

unit {
  description = "Shared Application Volume"
  after { "local-fs.target" }
}

volume {
  volumeName = "app-shared"
  driver = "local"
  user = "1000"
  group = "1000"

  type = "tmpfs"
  device = "tmpfs"
  options = "size=1G"

  label {
    ["app"] = "shared"
    ["tier"] = "storage"
  }
}

install {
  wantedBy { "multi-user.target" }
}
