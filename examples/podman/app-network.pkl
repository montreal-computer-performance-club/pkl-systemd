amends "../../podman/Network.pkl"

unit {
  description = "Application Network"
  after { "network.target" }
}

network {
  networkName = "app-net"
  driver = "bridge"
  subnet { "10.88.0.0/16" }
  gateway { "10.88.0.1" }

  label {
    ["app"] = "myapp"
    ["environment"] = "production"
  }
}

install {
  wantedBy { "multi-user.target" }
}
